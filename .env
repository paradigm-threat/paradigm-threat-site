NEXT_PUBLIC_METADATA_URL=https://paradigmthreat.net
NEXT_PUBLIC_SITE_URL=https://paradigmthreat.net
NEXT_PUBLIC_ASSET_PATH=app
NEXT_PUBLIC_ASSET_BUILD=dist
NEXT_PUBLIC_ASSET_NAV_IGNORE_FILE=.navignore
NEXT_PUBLIC_FILES_BASE_URL=https://paradigm-threat-files.dfw1.relaygateway.net https://paradigm-threat-files.lon1.relaygateway.net https://paradigm-threat-files.hkg1.relaygateway.net
# GitLab Pages origin (timeline); app loads /data/events.json and /index.json under this URL.
# Optional: TIMELINE_ORIGINS=pipe or newline-separated list (tried in order) for /export/* proxy; defaults to NEXT_PUBLIC_TIMELINE_BASE_URL only.
NEXT_PUBLIC_TIMELINE_BASE_URL=https://paradigm-threat-timeline.dfw1.relaygateway.net https://paradigm-threat-timeline.lon1.relaygateway.net https://paradigm-threat-timeline.hkg1.relaygateway.net

NEXT_PUBLIC_ASSET_GOACCESS_REPORT_HTML=report.html
NEXT_PUBLIC_ASSET_GOACCESS_REPORT_JSON=report.json

NEXT_PUBLIC_GIT_HASH_URL=https://gitlab.com/clevertree/paradigm-threat-files/-/commit/

NEXT_PUBLIC_CHAT_URL=https:/chat.paradigmthreat.net
NEXT_PRIVATE_CHAT_BOT_TOKEN=
NEXT_PUBLIC_AUTOGEN_IMAGE_WIDTH=384

# Piper TTS — public upstream bases (space or newline separated). Not secret; override in .env.local only if needed for local dev.
# Use https://host (port 443) in production: Vercel/serverless often cannot reach custom ports (e.g. :5590). Relay masters expose /tts and /voices via Caddy → clevertree-tts on 5590.
# Local dev may use http://127.0.0.1:5590
PIPER_API_URLS=https://dfw1.relaygateway.net https://lon1.relaygateway.net https://hkg1.relaygateway.net
NEXT_PUBLIC_PIPER_API_URLS=https://dfw1.relaygateway.net https://lon1.relaygateway.net https://hkg1.relaygateway.net
# Legacy single host if PIPER_API_URLS is unset: PIPER_API_URL=http://127.0.0.1:5590
# PIPER_API_SECRET — secrets only: .env.local (gitignored) and Vercel env vars

# WebMCP tools + reply assistant (client-only; normal site unchanged when off)
NEXT_PUBLIC_WEBMCP_ENABLED=1
NEXT_PUBLIC_WEBMCP_ACTUATION=1
# Server relay fetch for SSR articles, timeline API, TTS API (off: client Relay only; avoids stale CDN SSR)
NEXT_PUBLIC_SERVER_RELAY_FETCH=0
